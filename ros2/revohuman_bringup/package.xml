<?xml version="1.0"?>
<package format="3">
  <name>revohuman_bringup</name>
  <version>0.1.1</version>
  <description>RevoHuman SDK 的唯一 ROS2 入口：revohuman.launch.py 按 mode 拉起 bimanual_node（双手）或 glove_node（单手），参数集中在 config/revohuman.yaml。</description>
  <maintainer email="devnull@example.com">RevoHuman</maintainer>
  <license>Proprietary</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>revohuman_ros</exec_depend>
  <exec_depend>revohuman_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
